# Yard Web ops executor; runs allowlisted Yard CLI actions as jobs for Yard Web.
#
# It runs as the deploy user, the owner of /var/lib/yard, so a Web job does exactly what that user's
# `yard` command does: Git accepts the repositories, Docker comes from the user's docker group, and
# every file it writes (state, .git, .env, backups) keeps the owner the CLI expects. install-web.sh
# fills in @DEPLOY_USER@ and @DEPLOY_GROUP@ (the user's primary group, which systemd does not add
# by itself when Group= is set). Group=yard-web-ops owns the socket and the job history.
#
# Compared with yard-web-read.service this unit must deploy, back up and restore, so it
# deliberately relaxes the read profile (everything else is kept):
#   - PrivateNetwork removed: git fetch, image builds and backup commands use the network.
#   - ProtectSystem=full instead of strict, ProtectHome removed: repositories, Compose
#     directories, backup targets and the deploy user's git/docker credentials live outside
#     /var/lib/yard, and project manifests choose them. /usr, /boot and /etc stay read-only.
# NoNewPrivileges stays on, so jobs cannot gain privileges (sudo inside a backup command fails).
[Unit]
Description=Yard Web ops executor
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=@DEPLOY_USER@
Group=yard-web-ops
SupplementaryGroups=@DEPLOY_GROUP@
UMask=0007
RuntimeDirectory=yard-web-ops
RuntimeDirectoryMode=0750
# Keep the directory (same inode) across restarts so the container bind mount stays valid.
RuntimeDirectoryPreserve=yes
# Cap on the stored job history; the oldest finished jobs go first, running jobs never. 0 disables
# a cap. Override with a drop-in (systemctl edit yard-web-ops).
Environment=YARD_JOBS_MAX_COUNT=500
Environment=YARD_JOBS_MAX_BYTES=536870912
ExecStart=/usr/local/bin/yard ops-server --socket /run/yard-web-ops/ops.sock
Restart=on-failure
RestartSec=2
# Jobs are children of the executor; stopping it ends them (they are marked failed on restart).
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
